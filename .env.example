# Network tools API base URL (ping, dns, whois, traceroute, etc.)
PUBLIC_NETWORK_API_BASE=https://api.tool.tl/network

# Google Analytics 4 Measurement ID
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense Publisher ID (digits only, without ca-pub- prefix)
PUBLIC_ADSENSE_ID=XXXXXXXXXXXXXXXXXX
