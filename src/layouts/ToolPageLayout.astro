---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import AdSlot from '@/components/AdSlot.astro';
import ToolCard from '@/components/ToolCard.astro';
import type { Locale } from '@/i18n/config';
import { t, getLocalizedPath } from '@/i18n/utils';
import { getRelatedTools, type Tool } from '@/lib/tools';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  tool: Tool;
  canonicalPath: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  jsonLd?: object[];
}

const { title, description, locale, tool, canonicalPath, breadcrumbs, jsonLd: extraJsonLd } = Astro.props;

const relatedTools = getRelatedTools(tool);

// Structured data
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.label,
    ...(b.href ? { item: `https://tool.tl${b.href}` } : {}),
  })),
};

const langMap: Record<string, string> = { en: 'en', 'zh-CN': 'zh-Hans', 'zh-TW': 'zh-Hant', ja: 'ja' };
const softwareAppLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description: description,
  url: locale === 'en' ? `https://tool.tl/${canonicalPath}` : `https://tool.tl/${locale}/${canonicalPath}`,
  applicationCategory: 'UtilitiesApplication',
  browserRequirements: 'Requires JavaScript. Works in any modern browser.',
  operatingSystem: 'Any',
  inLanguage: langMap[locale] ?? 'en',
  isAccessibleForFree: true,
  ...(tool.keywords ? { featureList: tool.keywords.split(' ').filter(Boolean).join(', ') } : {}),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'tool.tl',
    url: 'https://tool.tl',
  },
};

// HowTo structured data
const toolOgImageUrl = `https://tool.tl/og/${tool.slug}.png`;
const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t('tool.howto_name', locale).replace('{name}', title),
  description: description,
  image: toolOgImageUrl,
  step: [
    {
      '@type': 'HowToStep',
      name: t('tool.howto_step1_name', locale),
      text: t('tool.howto_step1_text', locale).replace('{name}', title),
      image: toolOgImageUrl,
    },
    {
      '@type': 'HowToStep',
      name: t('tool.howto_step2_name', locale),
      text: t('tool.howto_step2_text', locale),
      image: toolOgImageUrl,
    },
    {
      '@type': 'HowToStep',
      name: t('tool.howto_step3_name', locale),
      text: t('tool.howto_step3_text', locale),
      image: toolOgImageUrl,
    },
  ],
};

// FAQPage structured data
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: t('tool.faq_free_q', locale).replace('{name}', title),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t('tool.faq_free_a', locale).replace('{name}', title),
      },
    },
    {
      '@type': 'Question',
      name: t('tool.faq_safe_q', locale).replace('{name}', title),
      acceptedAnswer: {
        '@type': 'Answer',
        text: t('tool.faq_safe_a', locale),
      },
    },
  ],
};

const allJsonLd = [breadcrumbLd, softwareAppLd, howToLd, faqLd, ...(extraJsonLd || [])];
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={canonicalPath}
  ogImage={`https://tool.tl/og/${tool.slug}.png`}
  jsonLd={allJsonLd}
>
  <Fragment slot="header">
    <Header locale={locale}>
      <LanguageSwitcher slot="language-switcher" locale={locale} currentPath={Astro.url.pathname} />
      <LanguageSwitcher slot="language-switcher-mobile" locale={locale} currentPath={Astro.url.pathname} />
    </Header>
  </Fragment>

  <!-- Breadcrumb -->
  <nav
    class="site-shell mx-auto px-4 sm:px-6 py-3 text-sm"
    aria-label="Breadcrumb"
    style="color: var(--color-text-secondary)"
  >
    <ol class="flex flex-wrap items-center gap-1">
      {breadcrumbs.map((crumb, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true">/</span>}
          {crumb.href ? (
            <a
              href={crumb.href}
              class="hover:underline"
              style="color: var(--color-primary)"
            >
              {crumb.label}
            </a>
          ) : (
            <span style="color: var(--color-text)">{crumb.label}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <!-- Two-column layout -->
  <div class="site-shell mx-auto px-4 sm:px-6 pb-12">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Main content -->
      <div class="flex-1 min-w-0">
        <AdSlot name="tool-top" format="horizontal" />

        <!-- Tool interactive area -->
        <div class="tool-area" data-pagefind-ignore>
          <slot />
        </div>

        <AdSlot name="tool-bottom" format="horizontal" />

        <!-- SEO content area (searchable by Pagefind) -->
        <div class="seo-content mt-8" data-pagefind-body data-pagefind-filter={`lang:${locale}`}>
          <slot name="seo-content" />
        </div>

        <AdSlot name="in-content" format="horizontal" />

        <!-- FAQ area -->
        <div class="faq-area mt-8">
          <slot name="faq" />
        </div>

        <!-- Related tools -->
        {relatedTools.length > 0 && (
          <section class="mt-10">
            <h2 class="text-xl font-bold mb-4" style="color: var(--color-text)">
              {t('tool.related', locale)}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedTools.map((rt) => (
                <ToolCard tool={rt} locale={locale} />
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="lg:w-72 xl:w-80 flex-shrink-0">
        <div class="lg:sticky lg:top-20 space-y-6">
          <AdSlot name="sidebar-1" format="rectangle" />

          <!-- Related tools sidebar -->
          {relatedTools.length > 0 && (
            <div
              class="rounded-xl border p-4"
              style="background-color: var(--color-card-bg); border-color: var(--color-border)"
            >
              <h3
                class="font-semibold mb-3 text-sm"
                style="color: var(--color-text-secondary)"
              >
                {t('tool.related', locale)}
              </h3>
              <ul class="space-y-2">
                {relatedTools.slice(0, 5).map((rt) => {
                  const rtName = rt.name[locale] || rt.name.en;
                  return (
                    <li>
                      <a
                        href={getLocalizedPath(rt.slug, locale)}
                        class="text-sm hover:underline block py-1"
                        style="color: var(--color-primary)"
                      >
                        {rtName}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          <AdSlot name="sidebar-2" format="rectangle" />
        </div>
      </aside>
    </div>
  </div>

  <AdSlot name="footer" format="horizontal" />

  <Fragment slot="footer">
    <Footer locale={locale} />
  </Fragment>
</BaseLayout>

<!-- Tool usage statistics — called by tool components on successful execution -->
<script is:inline>
  window.__trackToolUsed = function(slug) {
    var key = 'tool-exec-' + slug;
    var now = Date.now();
    var last = parseInt(localStorage.getItem(key) || '0', 10);
    if (now - last < 300000) return; // dedup: once per 5 min per tool
    localStorage.setItem(key, String(now));
    fetch('https://api.tool.tl/content/api/tool-usage/' + encodeURIComponent(slug) + '?site_id=2', { method: 'POST' }).catch(function(){});
  };
</script>
