---
import { getAlternateLinks, getLocalizedPath } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import CookieConsent from '@/components/CookieConsent';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: string;
  canonicalPath: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  locale = 'en',
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://tool.tl';
const siteName = 'tool.tl';
const normalizedTitle = title.trim();
const fullTitle = normalizedTitle.toLowerCase().endsWith(`| ${siteName}`)
  ? normalizedTitle
  : `${normalizedTitle} | ${siteName}`;

const _adsenseRaw = import.meta.env.PUBLIC_ADSENSE_ID || '';
// PUBLIC_ADSENSE_ID 实际形如 'pub-9845089349130720'（已含 pub-），只需补 'ca-' 前缀。
// 之前错写成 `ca-pub-${...}` 会拼出 'ca-pub-pub-9845...'，导致页面级脚本 client 参数错位，
// AdSense 后台 page view 计数为 0（impression 仍正常，因为 ad unit 的 data-ad-client 是对的）。
const adClient = _adsenseRaw
  ? (_adsenseRaw.startsWith('ca-') ? _adsenseRaw : `ca-${_adsenseRaw}`)
  : '';

const canonicalUrl =
  locale === 'en'
    ? `${siteUrl}/${canonicalPath}`
    : `${siteUrl}/${locale}/${canonicalPath}`;

const alternateLinks = getAlternateLinks(canonicalPath);

const ogImageUrl = ogImage ?? `${siteUrl}/og-default.png`;
const ogHasDimensions = true;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'tool.tl',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 禁止百度等移动搜索对页面做转码 / App 化（转码会剥离站点 CSS，导致移动端裸样式） */}
    <meta http-equiv="Cache-Control" content="no-transform" />
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <meta name="applicable-device" content="pc,mobile" />
    <meta name="MobileOptimized" content="width" />
    <meta name="HandheldFriendly" content="true" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonicalUrl} />

    {
      alternateLinks.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }

    <!-- OpenGraph -->
    <meta property="og:site_name" content="tool.tl" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale === 'zh-CN' ? 'zh_CN' : locale === 'zh-TW' ? 'zh_TW' : locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:image" content={ogImageUrl} />
    {ogHasDimensions && <meta property="og:image:width" content="1200" />}
    {ogHasDimensions && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tooltl" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Theme initialization (must be inline and synchronous to prevent FOUC) -->
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = stored === 'dark' || (stored !== 'light' && prefersDark);
        if (isDark) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      })();
    </script>

    <!-- Browser language auto-redirect (only on English/default pages) -->
    <script is:inline define:vars={{ pageLocale: locale }}>
      (function() {
        if (pageLocale !== 'en') return;
        if (localStorage.getItem('locale-preference')) return;

        var path = window.location.pathname;
        var localizedPrefixes = ['/zh-CN/', '/zh-TW/', '/ja/'];
        for (var i = 0; i < localizedPrefixes.length; i++) {
          if (path.startsWith(localizedPrefixes[i]) || path === localizedPrefixes[i].slice(0, -1)) return;
        }

        var langs = (navigator.languages && navigator.languages.length)
          ? Array.from(navigator.languages)
          : [navigator.language || ''];

        function resolveLocale(lang) {
          var l = String(lang || '').toLowerCase();
          if (!l) return '';
          if (l === 'ja' || l.startsWith('ja-')) return 'ja';
          if (l === 'zh-tw' || l === 'zh-hk' || l === 'zh-mo' || l === 'zh-hant' || l.startsWith('zh-hant-')) return 'zh-TW';
          if (l === 'zh' || l === 'zh-cn' || l === 'zh-sg' || l === 'zh-my' || l === 'zh-hans' || l.startsWith('zh-hans-')) return 'zh-CN';
          return '';
        }

        var target = '';
        for (var j = 0; j < langs.length; j++) {
          target = resolveLocale(langs[j]);
          if (target) break;
        }
        if (!target) return;

        var key = 'tl_locale_redirect';
        var nextPath = '/' + target + path.replace(/^\/en(?=\/|$)/, '');
        if (nextPath === window.location.pathname) return;
        if (sessionStorage.getItem(key) === nextPath) return;
        sessionStorage.setItem(key, nextPath);
        window.location.replace(nextPath + window.location.search + window.location.hash);
      })();
    </script>

    <!-- Google Analytics via self-hosted proxy -->
    <script is:inline async src={`/beacon/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
    <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      var proxyUrl = window.location.protocol + "//" + window.location.hostname + "/beacon/";
      gtag('config', gaId, {
        'transport_url': proxyUrl
      });
    </script>

    <!-- Google AdSense -->
    {adClient && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`} crossorigin="anonymous"></script>}

    <!-- Structured Data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    {jsonLd && (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((ld) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>

  <body
    class="min-h-screen flex flex-col"
    style="background-color: var(--color-bg); color: var(--color-text)"
  >
    <a href="#main-content" class="skip-link">Skip to content</a>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />

    <CookieConsent client:idle locale={locale} privacyPath={getLocalizedPath('privacy', locale as Locale)} />
  </body>
</html>
