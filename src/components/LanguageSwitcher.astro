---
import { locales, localeNames, type Locale } from '@/i18n/config';
import { getLocalizedPath, getPathWithoutLocale } from '@/i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const pathWithoutLocale = getPathWithoutLocale(currentPath);
---

<div class="language-switcher relative">
  <button
    type="button"
    class="lang-btn flex items-center gap-1 px-2 py-2 rounded-md text-sm min-h-[40px] min-w-[44px] justify-center"
    style="color: var(--color-text-secondary)"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Switch language"
  >
    <span class="text-base">🌐</span>
    <span class="hidden sm:inline whitespace-nowrap">{localeNames[locale].split('').slice(0, 2).join('')}</span>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  <div
    class="lang-dropdown absolute right-0 top-full mt-1 py-1 rounded-lg shadow-lg border min-w-[140px] hidden z-50"
    style="background-color: var(--color-card-bg); border-color: var(--color-border)"
    role="menu"
  >
    {locales.map((loc) => (
      <a
        href={getLocalizedPath(pathWithoutLocale, loc)}
        class:list={[
          'block px-4 py-2 text-sm transition-colors',
          loc === locale ? 'font-semibold' : '',
        ]}
        style={loc === locale
          ? 'color: var(--color-primary); background-color: var(--color-primary-light)'
          : 'color: var(--color-text)'}
        role="menuitem"
        hreflang={loc === 'zh-CN' ? 'zh-Hans' : loc === 'zh-TW' ? 'zh-Hant' : loc}
        data-locale={loc}
      >
        {localeNames[loc]}
      </a>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll('.language-switcher').forEach((switcher) => {
    const btn = switcher.querySelector('.lang-btn');
    const dropdown = switcher.querySelector('.lang-dropdown');
    if (!btn || !dropdown) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !dropdown.classList.contains('hidden');
      dropdown.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', () => {
      dropdown.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    });

    dropdown.querySelectorAll('a[data-locale]').forEach((link) => {
      link.addEventListener('click', () => {
        const loc = (link as HTMLElement).dataset.locale;
        if (loc) localStorage.setItem('locale-preference', loc);
        // Clear auto-redirect flag so the new locale preference is respected
        sessionStorage.removeItem('tl_locale_redirect');
      });
    });
  });
</script>
