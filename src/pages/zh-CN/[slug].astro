---
import ToolPageLayout from '@/layouts/ToolPageLayout.astro';
import type { Locale } from '@/i18n/config';
import { t, getLocalizedPath } from '@/i18n/utils';
import { getAllTools, getToolBySlug, getToolName, getToolDescription, type Tool } from '@/lib/tools';
import FileUploadTool from '@/components/tools/FileUploadTool';
import TextProcessTool from '@/components/tools/TextProcessTool';
import NetworkTool from '@/components/tools/NetworkTool';
import GeneratorTool from '@/components/tools/GeneratorTool';
import EmailDiagnosticsTool from '@/components/tools/EmailDiagnosticsTool';
import ExchangeRateTool from '@/components/tools/ExchangeRateTool';
import BaseConverterTool from '@/components/tools/BaseConverterTool';
import ChecksumCalculatorTool from '@/components/tools/ChecksumCalculatorTool';
import HexArithmeticTool from '@/components/tools/HexArithmeticTool';
import CrcCalculatorTool from '@/components/tools/CrcCalculatorTool';
import TextStatsTool from '@/components/tools/TextStatsTool';
import TextProcessorTool from '@/components/tools/TextProcessorTool';
import Base64DecoderImgTool from '@/components/tools/Base64DecoderImgTool';
import FileSizeConverterTool from '@/components/tools/FileSizeConverterTool';
import JsonFormatterTool from '@/components/tools/JsonFormatterTool';
import VideoConverterTool from '@/components/tools/VideoConverterTool';
import JwtDebuggerTool from '@/components/tools/JwtDebuggerTool';
import WebpConverterTool from '@/components/tools/WebpConverterTool';
import CompressPdfTool from '@/components/tools/CompressPdfTool';
import GifSplitTool from '@/components/tools/GifSplitTool';
import FaviconInspectTool from '@/components/tools/FaviconInspectTool';
import TotpGeneratorTool from '@/components/tools/TotpGeneratorTool';
import TextCaseTool from '@/components/tools/TextCaseTool';
import Base64EncoderImgTool from '@/components/tools/Base64EncoderImgTool';
import MortgageCalculatorTool from '@/components/tools/MortgageCalculatorTool';
import ROICalculatorTool from '@/components/tools/ROICalculatorTool';
import ProfitMarginTool from '@/components/tools/ProfitMarginTool';
import BreakEvenTool from '@/components/tools/BreakEvenTool';
import SalaryAfterTaxTool from '@/components/tools/SalaryAfterTaxTool';
import ImageCompressorTool from '@/components/tools/ImageCompressorTool';
import SaasChurnTool from '@/components/tools/SaasChurnTool';
import LtvCalculatorTool from '@/components/tools/LtvCalculatorTool';
import WebRTCLeakTestTool from '@/components/tools/WebRTCLeakTestTool';
import ResizeImageTool from '@/components/tools/ResizeImageTool';
import LoanAmortizationTool from '@/components/tools/LoanAmortizationTool';
import BrowserFingerprintTool from '@/components/tools/BrowserFingerprintTool';
import ImageToPdfTool from '@/components/tools/ImageToPdfTool';
import OgImageGeneratorTool from '@/components/tools/OgImageGeneratorTool';
import CarInsuranceCalculatorTool from '@/components/tools/CarInsuranceCalculatorTool';
import MergePdfTool from '@/components/tools/MergePdfTool';
import SplitPdfTool from '@/components/tools/SplitPdfTool';
import DnsLeakTestTool from '@/components/tools/DnsLeakTestTool';
import IpBlockTestTool from '@/components/tools/IpBlockTestTool';
import CompoundInterestTool from '@/components/tools/CompoundInterestTool';
import CreditCardPayoffTool from '@/components/tools/CreditCardPayoffTool';
import TaxBracketTool from '@/components/tools/TaxBracketTool';
import RetirementCalculatorTool from '@/components/tools/RetirementCalculatorTool';
import NetWorthCalculatorTool from '@/components/tools/NetWorthCalculatorTool';
import BMICalculatorTool from '@/components/tools/BMICalculatorTool';
import InvoiceGeneratorTool from '@/components/tools/InvoiceGeneratorTool';
import RsaEncryptDecryptTool from '@/components/tools/RsaEncryptDecryptTool';
import TextQrcodeTool from '@/components/tools/TextQrcodeTool';

const locale: Locale = 'zh-CN';

export function getStaticPaths() {
  const tools = getAllTools();
  return tools.map((tool) => ({
    params: { slug: tool.slug },
  }));
}

const { slug } = Astro.params;
const tool = getToolBySlug(slug!)!;
const name = getToolName(tool, locale);
const description = getToolDescription(tool, locale);
const subtitle = tool.subtitle?.[locale] || tool.subtitle?.en || '';

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: `/${locale}` },
  { label: t(`nav.category.${tool.category}`, locale), href: `/${locale}#${tool.category}` },
  { label: name },
];

const toolProps = {
  slug: tool.slug,
  apiType: tool.apiType,
  apiEndpoint: tool.apiEndpoint || '',
  locale,
};
---

<ToolPageLayout
  title={name}
  description={description}
  locale={locale}
  tool={tool}
  canonicalPath={tool.slug}
  breadcrumbs={breadcrumbs}
>
  <h1 class="text-2xl font-bold mb-2" style="color: var(--color-text)">{name}</h1>
  {subtitle && <p class="mb-6" style="color: var(--color-text-secondary)">{subtitle}</p>}

  {tool.category === 'email' && (
    <EmailDiagnosticsTool client:load {...toolProps} />
  )}
  {tool.apiType === 'network' && tool.category !== 'email' && tool.component !== 'DnsLeakTest' && tool.component !== 'IpBlockTest' && (
    <NetworkTool client:load {...toolProps} />
  )}
  {tool.apiType === 'convert' && tool.category !== 'email' && tool.component !== 'ToMp4' && tool.component !== 'WebpTo' && tool.component !== 'CompressPdf' && tool.component !== 'GifSplit' && tool.component !== 'MergePdf' && tool.component !== 'SplitPdf' && tool.component !== 'FaviconInspect' && (
    <FileUploadTool client:load {...toolProps} />
  )}
  {tool.component === 'FileSizeConverter' && (
    <FileSizeConverterTool client:load {...toolProps} />
  )}
  {tool.component === 'JsonFormatter' && (
    <JsonFormatterTool client:load {...toolProps} />
  )}
  {tool.component === 'Base64DecoderImg' && (
    <Base64DecoderImgTool client:load {...toolProps} />
  )}
  {tool.component === 'ToMp4' && (
    <VideoConverterTool client:load {...toolProps} />
  )}
  {tool.component === 'JwtDebugger' && (
    <JwtDebuggerTool client:load {...toolProps} />
  )}
  {tool.component === 'WebpTo' && (
    <WebpConverterTool client:load {...toolProps} />
  )}
  {tool.component === 'CompressPdf' && (
    <CompressPdfTool client:load {...toolProps} />
  )}
  {tool.component === 'GifSplit' && (
    <GifSplitTool client:load {...toolProps} />
  )}
  {tool.component === 'FaviconInspect' && (
    <FaviconInspectTool client:load {...toolProps} />
  )}
  {tool.component === 'TotpGenerator' && (
    <TotpGeneratorTool client:load {...toolProps} />
  )}
  {tool.component === 'TextCase' && (
    <TextCaseTool client:load {...toolProps} />
  )}
  {tool.component === 'Base64EncoderImg' && (
    <Base64EncoderImgTool client:load {...toolProps} />
  )}
  {tool.component === 'MortgageCalculator' && (
    <MortgageCalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'ROICalculator' && (
    <ROICalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'ProfitMargin' && (
    <ProfitMarginTool client:load {...toolProps} />
  )}
  {tool.component === 'BreakEven' && (
    <BreakEvenTool client:load {...toolProps} />
  )}
  {tool.component === 'SalaryAfterTax' && (
    <SalaryAfterTaxTool client:load {...toolProps} />
  )}
  {tool.component === 'ImageCompressor' && (
    <ImageCompressorTool client:load {...toolProps} />
  )}
  {tool.component === 'SaasChurn' && (
    <SaasChurnTool client:load {...toolProps} />
  )}
  {tool.component === 'LtvCalculator' && (
    <LtvCalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'WebRTCLeakTest' && (
    <WebRTCLeakTestTool client:load {...toolProps} />
  )}
  {tool.component === 'ResizeImage' && (
    <ResizeImageTool client:load {...toolProps} />
  )}
  {tool.component === 'LoanAmortization' && (
    <LoanAmortizationTool client:load {...toolProps} />
  )}
  {tool.component === 'BrowserFingerprint' && (
    <BrowserFingerprintTool client:load {...toolProps} />
  )}
  {tool.component === 'ImageToPdf' && (
    <ImageToPdfTool client:load {...toolProps} />
  )}
  {tool.component === 'OgImageGenerator' && (
    <OgImageGeneratorTool client:load {...toolProps} />
  )}
  {tool.component === 'CarInsuranceCalculator' && (
    <CarInsuranceCalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'MergePdf' && (
    <MergePdfTool client:load {...toolProps} />
  )}
  {tool.component === 'SplitPdf' && (
    <SplitPdfTool client:load {...toolProps} />
  )}
  {tool.component === 'DnsLeakTest' && (
    <DnsLeakTestTool client:load {...toolProps} />
  )}
  {tool.component === 'IpBlockTest' && (
    <IpBlockTestTool client:load {...toolProps} />
  )}
  {tool.component === 'CompoundInterest' && (
    <CompoundInterestTool client:load {...toolProps} />
  )}
  {tool.component === 'CreditCardPayoff' && (
    <CreditCardPayoffTool client:load {...toolProps} />
  )}
  {tool.component === 'TaxBracket' && (
    <TaxBracketTool client:load {...toolProps} />
  )}
  {tool.component === 'RetirementCalculator' && (
    <RetirementCalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'NetWorthCalculator' && (
    <NetWorthCalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'BMICalculator' && (
    <BMICalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'InvoiceGenerator' && (
    <InvoiceGeneratorTool client:load {...toolProps} />
  )}
    {tool.component === 'CrcCalculator' && (
    <CrcCalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'HexArithmetic' && (
    <HexArithmeticTool client:load {...toolProps} />
  )}
  {tool.component === 'TextStats' && (
    <TextStatsTool client:load {...toolProps} />
  )}
  {tool.component === 'TextProcessor' && (
    <TextProcessorTool client:load {...toolProps} />
  )}
  {tool.component === 'ChecksumCalculator' && (
    <ChecksumCalculatorTool client:load {...toolProps} />
  )}
  {tool.component === 'BaseConverter' && (
    <BaseConverterTool client:load {...toolProps} />
  )}
  {tool.component === 'RsaEncryptDecrypt' && (
    <RsaEncryptDecryptTool client:load {...toolProps} />
  )}
  {tool.component === 'TextQrcode' && (
    <TextQrcodeTool client:load {...toolProps} />
  )}
  {tool.apiType === 'frontend' && (tool.component === 'UrlDecoder' || tool.component === 'UrlEncoder' || (tool.category === 'dev' && tool.component !== 'ChineseToPinyin' && tool.component !== 'ColorConverter' && tool.component !== 'BaseConverter' && tool.component !== 'ChecksumCalculator' && tool.component !== 'HexArithmetic' && tool.component !== 'CrcCalculator' && tool.component !== 'TextStats' && tool.component !== 'TextProcessor' && tool.component !== 'FileSizeConverter' && tool.component !== 'JsonFormatter' && tool.component !== 'JwtDebugger' && tool.component !== 'TextCase' && tool.component !== 'OgImageGenerator' && tool.component !== 'RsaEncryptDecrypt')) && (
    <TextProcessTool client:load {...toolProps} component={tool.component} />
  )}
  {tool.component === 'ExchangeRate' && (
    <ExchangeRateTool client:load {...toolProps} />
  )}
  {tool.apiType === 'frontend' && tool.component !== 'ExchangeRate' && tool.component !== 'Base64DecoderImg' && tool.component !== 'Base64EncoderImg' && tool.component !== 'UrlDecoder' && tool.component !== 'UrlEncoder' && tool.component !== 'TotpGenerator' && tool.component !== 'MortgageCalculator' && tool.component !== 'ROICalculator' && tool.component !== 'ProfitMargin' && tool.component !== 'BreakEven' && tool.component !== 'SalaryAfterTax' && tool.component !== 'ImageCompressor' && tool.component !== 'SaasChurn' && tool.component !== 'LtvCalculator' && tool.component !== 'WebRTCLeakTest' && tool.component !== 'ResizeImage' && tool.component !== 'LoanAmortization' && tool.component !== 'BrowserFingerprint' && tool.component !== 'ImageToPdf' && tool.component !== 'OgImageGenerator' && tool.component !== 'CarInsuranceCalculator' && tool.component !== 'TaxBracket' && tool.component !== 'CreditCardPayoff' && tool.component !== 'CompoundInterest' && tool.component !== 'RetirementCalculator' && tool.component !== 'NetWorthCalculator' && tool.component !== 'BMICalculator' && tool.component !== 'InvoiceGenerator' && tool.component !== 'TextQrcode' && (tool.category !== 'dev' || tool.component === 'ChineseToPinyin' || tool.component === 'ColorConverter') && (
    <GeneratorTool client:load {...toolProps} component={tool.component} />
  )}

  <Fragment slot="seo-content">
    <h2>{t('tool.what_is', locale).replace('{name}', name)}</h2>
    <p>{description}</p>

    {tool.slug === 'text-qrcode' ? (
      <Fragment>
        <h2>它解决什么：跨设备复制文字的痛点</h2>
        <p>电脑上有一段文字——一个网址、一串验证码、一个 Wi-Fi 密码、一个地址，或一段文案——你想在手机上用。常规办法都很别扭：发给自己的微信/QQ、发邮件、靠云笔记同步，或者照着屏幕手动敲。苹果的「通用剪贴板」只在苹果设备之间有效，而 Windows 和 iPhone、Android 和 Mac 之间根本没有原生的剪贴板互通。这个工具把这一切压成一个动作：电脑上粘贴，手机上扫码，一键复制。</p>
        <h2>如何使用</h2>
        <ol>
          <li><strong>粘贴文字</strong>：在电脑上粘贴要传的内容，点「生成二维码」，二维码立即出现。</li>
          <li><strong>手机扫码</strong>：用手机相机或任意扫码 App 扫一扫，会打开一个显示这段文字的网页。</li>
          <li><strong>一键复制</strong>：点复制按钮，文字就进了手机剪贴板，可粘贴到任何 App。</li>
        </ol>
        <h2>常见用途</h2>
        <ul>
          <li>把电脑上的长网址、文章链接传到手机，不用手打</li>
          <li>把验证码 / 一次性密码传到正在登录的那台设备</li>
          <li>把 Wi-Fi 密码分享给客人的手机</li>
          <li>把地址、电话、收货信息传进手机 App</li>
          <li>把命令、代码片段或备注从电脑传到手机</li>
        </ul>
        <p>无需注册、无需装 App，跨任何带摄像头的设备都能用，包括 Windows、macOS、Android、iPhone 之间。二维码里存的是一个短分享链接（而非原始文字），所以内容再长二维码也依然好扫；分享的文字会在 2 小时后自动清除，验证码、密码这类内容不会留在聊天记录里。</p>
      </Fragment>
    ) : (
      <Fragment>
        <h2>{t('tool.how_to_use', locale)}</h2>
        <ol>
          <li><strong>{t('tool.howto_step1_name', locale)}</strong> — {t('tool.howto_step1_text', locale).replace('{name}', name)}</li>
          <li><strong>{t('tool.howto_step2_name', locale)}</strong> — {t('tool.howto_step2_text', locale)}</li>
          <li><strong>{t('tool.howto_step3_name', locale)}</strong> — {t('tool.howto_step3_text', locale)}</li>
        </ol>
      </Fragment>
    )}

    <h2>{t('tool.faq', locale)}</h2>
    <h3>{t('tool.faq_free_q', locale).replace('{name}', name)}</h3>
    <p>{t('tool.faq_free_a', locale).replace('{name}', name)}</p>
    <h3>{t('tool.faq_safe_q', locale).replace('{name}', name)}</h3>
    <p>{t('tool.faq_safe_a', locale)}</p>
  </Fragment>
</ToolPageLayout>
