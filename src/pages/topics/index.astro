---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import AdSlot from '@/components/AdSlot.astro';
import { fetchCategories } from '@/lib/content-api';
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

const locale: Locale = 'en';

let categories: any[] = [];
try {
  categories = await fetchCategories(locale);
  categories = categories.filter((c: any) => c.article_count > 0);
} catch (e) {}
---

<BaseLayout
  title={t('topics.title', locale)}
  description={t('topics.subtitle', locale)}
  locale={locale}
  canonicalPath="topics"
>
  <Fragment slot="header">
    <Header locale={locale}>
      <LanguageSwitcher slot="language-switcher" locale={locale} currentPath={Astro.url.pathname} />
      <LanguageSwitcher slot="language-switcher-mobile" locale={locale} currentPath={Astro.url.pathname} />
    </Header>
  </Fragment>

  <div class="site-shell mx-auto px-4 sm:px-6 py-10">
    <AdSlot name="blog-top" format="horizontal" />

    <h1 class="text-3xl font-bold mb-2 mt-6" style="color: var(--color-text)">
      {t('topics.title', locale)}
    </h1>
    <p class="mb-8" style="color: var(--color-text-secondary)">
      {t('topics.subtitle', locale)}
    </p>

    {categories.length === 0 ? (
      <p class="py-10 text-center" style="color: var(--color-text-secondary)">
        {t('blog.no_articles', locale)}
      </p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {categories.map((cat: any, index: number) => (
          <>
            <a
            href={`/topics/${cat.slug}`}
            class="block rounded-xl border p-5 transition-all hover:shadow-md"
            style="background-color: var(--color-card-bg); border-color: var(--color-border); text-decoration: none;"
          >
            <h2 class="text-lg font-bold mb-1" style="color: var(--color-text)">
              {cat.name}
            </h2>
            {cat.desc && (
              <p class="text-sm mb-3 line-clamp-2" style="color: var(--color-text-secondary)">
                {cat.desc}
              </p>
            )}
            <div class="flex items-center justify-between text-xs" style="color: var(--color-text-secondary)">
              <span>{cat.article_count} {t('topics.articles', locale)}</span>
              {cat.last_updated && (
                <span>{t('topics.last_updated', locale)}: {cat.last_updated.slice(0, 10)}</span>
              )}
            </div>
            <div class="mt-3 text-sm font-medium" style="color: var(--color-primary)">
              {t('topics.view_articles', locale)} →
            </div>
          </a>
            {index === 1 && <AdSlot name="in-feed" format="fluid" class="rounded-xl border p-0" />}
          </>
        ))}
      </div>
    )}

    <AdSlot name="blog-bottom" format="horizontal" />
  </div>

  <Fragment slot="footer">
    <Footer locale={locale} />
  </Fragment>
</BaseLayout>
