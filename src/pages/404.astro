---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ToolCard from '@/components/ToolCard.astro';
import { t } from '@/i18n/utils';
import { getAllTools } from '@/lib/tools';
import type { Locale } from '@/i18n/config';

const locale: Locale = 'en';
const popularSlugs = ['json-formatter', 'compress-pdf', 'pdf-to-word', 'png-to-jpg', 'uuid-generator', 'password-generator'];
const allTools = getAllTools();
const popularTools = popularSlugs
  .map((slug) => allTools.find((t) => t.slug === slug))
  .filter(Boolean);
---

<BaseLayout
  title={t('404.title', locale)}
  description={t('404.message', locale)}
  locale={locale}
  canonicalPath="404"
  noindex={true}
>
  <Fragment slot="header">
    <Header locale={locale}>
      <LanguageSwitcher slot="language-switcher" locale={locale} currentPath="/404" />
      <LanguageSwitcher slot="language-switcher-mobile" locale={locale} currentPath="/404" />
    </Header>
  </Fragment>

  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center">
    <h1 class="text-6xl font-bold mb-4" style="color: var(--color-primary)">404</h1>
    <p class="text-xl mb-2" style="color: var(--color-text)">{t('404.title', locale)}</p>
    <p class="mb-8" style="color: var(--color-text-secondary)">{t('404.message', locale)}</p>
    <a
      href="/"
      class="inline-block px-6 py-3 rounded-lg font-medium text-white"
      style="background-color: var(--color-primary)"
    >
      {t('404.back_home', locale)}
    </a>
  </div>

  <!-- Popular tools -->
  <section class="site-shell mx-auto px-4 sm:px-6 pb-16">
    <h2 class="text-xl font-bold mb-4 text-center" style="color: var(--color-text)">
      {t('404.popular_tools', locale)}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {popularTools.map((tool) => tool && <ToolCard tool={tool} locale={locale} />)}
    </div>
  </section>

  <Fragment slot="footer">
    <Footer locale={locale} />
  </Fragment>
</BaseLayout>
